FROM node:18-alpine AS builder
WORKDIR /app

# Copy manifests and run standard install to resolve sub-dependencies
COPY package.json package-lock.json ./
RUN npm install

# Copy source and compile React assets
COPY . .
RUN npm run build

# Serve via Nginx
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]